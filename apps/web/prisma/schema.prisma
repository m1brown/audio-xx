generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Local dev uses file:./dev.db; production uses Turso via the adapter
  // in prisma.ts. This URL is only needed for prisma generate / migrate.
  url = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String?
  createdAt    DateTime      @default(now()) @map("created_at")
  profile      Profile?
  systems      System[]
  subscription Subscription?
  resetTokens  PasswordResetToken[]

  @@map("users")
}

// ── Password recovery (pre-beta item 3) ─────────────────────────────────
// Single-use, time-boxed reset tokens. Only the SHA-256 hash of the token
// is stored — a database leak cannot be replayed as a reset link. Rows are
// additive-only (additive Turso migration, same process as M5 billing).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ── Billing (MVP M5 — My Systems subscription) ──────────────────────────
// One row per user, created at first checkout. Server-side authority for
// entitlement; synchronised from verified Stripe webhooks. No card data
// is ever stored. Absence of a row + expired trial = expired state.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique @map("user_id")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String    @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  /** Stripe status: active | past_due | canceled | incomplete | … */
  status               String
  /** Paid-through instant; access to protected actions runs to here. */
  currentPeriodEnd     DateTime? @map("current_period_end")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  /** Stripe event.created of the newest applied event — guards against
   *  out-of-order webhook delivery. */
  lastEventAt          DateTime? @map("last_event_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("subscriptions")
}

// Webhook idempotency ledger: a Stripe event id is processed at most once.
model ProcessedStripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_stripe_events")
}

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomSize         String?  @map("room_size")
  roomType         String?  @map("room_type")
  listeningLevel   String?  @map("listening_level")
  sourceTypes      String   @default("[]") @map("source_types")        // JSON array
  sensitivityFlags String   @default("[]") @map("sensitivity_flags")   // JSON array
  preferredTraits  String   @default("[]") @map("preferred_traits")    // JSON array
  archetypes       String   @default("[]")                              // JSON array
  notes            String?
  activeSystemId   String?  @map("active_system_id")                   // soft ref to System.id

  // ── Onboarding fields ──────────────────────────────────────────────
  experienceLevel  String?  @map("experience_level")                   // "beginner" | "intermediate" | "experienced"
  intent           String?                                              // "understand" | "improve" | "choose" | "explore"
  musicGenres      String   @default("[]") @map("music_genres")        // JSON array
  listeningStyle   String?  @map("listening_style")                    // "focused" | "background" | "both"
  locale           String?                                              // e.g. "en-US", "fr-EU"
  onboardedAt      DateTime? @map("onboarded_at")                      // null = not yet onboarded

  @@map("profiles")
}

model System {
  id         String            @id @default(cuid())
  userId     String            @map("user_id")
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  notes      String?
  location   String?                                                    // e.g. "living room", "office"
  room       String?                                                    // room description or acoustics notes
  primaryUse String?           @map("primary_use")                     // e.g. "critical listening", "background music"
  tendencies String?           @default("{}") @map("tendencies")       // JSON or plain-text system character summary
  // Canonical engine input this system was saved from (MVP M2). The
  // assessment URL is the system's canonical identity; this column is
  // its normalized text form and drives duplicate detection per user.
  canonicalText String?        @map("canonical_text")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  components SystemComponent[]
  snapshots  PreferenceSnapshot[]
  assessments AssessmentSnapshot[]

  @@map("systems")
}

// ── Assessment snapshots (MVP M2 — My Systems) ─────────────────────────
// Immutable record of the assessment exactly as rendered at save time.
// Engine evolution never rewrites history: re-assessing appends a new row.
model AssessmentSnapshot {
  id            String   @id @default(cuid())
  /**
   * Unguessable capability for View/Print. The DB id is never a URL.
   *
   * NULLABLE rather than defaulted: a UNIQUE column with a constant default
   * admits exactly one row, so `@default("")` made the second snapshot fail to
   * insert. SQLite permits many NULLs in a unique index, which is what lets
   * pre-existing rows coexist with tokenised ones.
   */
  viewToken     String?  @unique @map("view_token")
  /** Minted ONLY by an explicit Share. Null = never shared. */
  shareToken    String?  @unique @map("share_token")
  /** Nullable: an anonymous listener may create, view and print a snapshot. */
  systemId      String?  @map("system_id")
  system        System?  @relation(fields: [systemId], references: [id], onDelete: Cascade)
  userId        String?  @map("user_id")
  /** Legacy: canonical engine input. Retained for old rows; never read by the
   *  artifact, because carrying the input is what made re-derivation possible. */
  systemText    String   @map("system_text") @default("")
  /** Legacy: synthesized ArtifactPayload. Superseded by snapshotJson. */
  payloadJson   String   @map("payload_json") @default("")
  /** The frozen AssessmentSnapshotV1 — the authoritative rendered state. */
  snapshotJson  String   @map("snapshot_json") @default("")
  /** Schema of snapshotJson, e.g. "axx.assessment.v1". */
  schemaVersion String   @map("schema_version") @default("")
  engineVersion String   @map("engine_version")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([systemId])
  @@map("assessment_snapshots")
}


model Component {
  id               String            @id @default(cuid())
  seedId           String?           @unique @map("seed_id")  // matches YAML id for seed components
  name             String
  brand            String
  category         String
  confidenceLevel  String            @map("confidence_level")
  roleConfidence   String?           @map("role_confidence")   // JSON map
  traitTendencies  String            @default("{}") @map("trait_tendencies")  // JSON map
  riskFlags        String            @default("[]") @map("risk_flags")        // JSON array
  trustedRefs      String            @default("[]") @map("trusted_refs")      // JSON array
  reviews          String            @default("[]")                            // JSON array
  retailerLinks    String            @default("[]") @map("retailer_links")    // JSON array
  isReference      Boolean           @default(false) @map("is_reference")
  userSubmitted    Boolean           @default(false) @map("user_submitted")
  systems          SystemComponent[]

  @@map("components")
}

model SystemComponent {
  id           String   @id @default(cuid())
  systemId     String   @map("system_id")
  system       System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  componentId  String   @map("component_id")
  component    Component @relation(fields: [componentId], references: [id])
  roleOverride String?  @map("role_override")
  notes        String?
  addedAt      DateTime @default(now()) @map("added_at")
  actionLog    String   @default("[]") @map("action_log")  // JSON array of { action, timestamp }

  @@unique([systemId, componentId])
  @@map("system_components")
}

model PreferenceSnapshot {
  id               String   @id @default(cuid())
  systemId         String   @map("system_id")
  system           System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  inputText        String   @map("input_text")
  extractedSignals String   @default("{}") @map("extracted_signals")  // JSON
  firedRules       String   @default("[]") @map("fired_rules")        // JSON array of rule IDs
  output           String   @default("{}") @map("output")             // JSON
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("preference_snapshots")
}

model ReferenceSystem {
  id           String  @id @default(cuid())
  seedId       String? @unique @map("seed_id")
  name         String
  archetype    String
  componentIds String  @map("component_ids")  // JSON array
  description  String
  isCommercial Boolean @default(false) @map("is_commercial")

  @@map("reference_systems")
}
